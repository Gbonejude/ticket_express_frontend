{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // `describe`/`it`/`expect` are global (vitest `globals: true`).
    "types": ["vitest/globals"],

    /* No `baseUrl`: it is deprecated in TypeScript 5.9 and removed in 7.0, and
       since 4.1 `paths` no longer needs it — the patterns below resolve
       relative to this file. Mirrors the `@` alias in `vite.config.ts`. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strictness — worth paying for on a greenfield project: the API layer is
       typed end to end, so a wrong field name fails at type-check, not at runtime. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  }
}
