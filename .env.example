# =============================================================================
# ticketExpress-frontend — environment template
# Copy this file to `.env` and adjust the values for your machine.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put a secret here: everything below ships to the client.
# =============================================================================

# --- API ---------------------------------------------------------------------
# Base URL of the TicketExpress API, version segment included, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds.
VITE_API_TIMEOUT=15000

# --- Application -------------------------------------------------------------
VITE_APP_NAME=Ticket Express
VITE_APP_URL=http://localhost:5173
VITE_APP_CURRENCY=XOF
VITE_APP_LOCALE=fr-FR

# Login page of TicketExpress-dashboard. Approved organizers are handed over to
# this URL to create and manage their events — the public site never does.
VITE_DASHBOARD_URL=http://localhost:5174

# --- Dev server --------------------------------------------------------------
VITE_DEV_PORT=5173
