{
  "name": "ticketexpress-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "overridesComment": "brace-expansion <=5.0.7 is vulnerable to a DoS by unbounded expansion (GHSA-mh99-v99m-4gvg). It reaches us only via @vue/test-utils -> js-beautify -> minimatch, which is dev-only, but 5.x ships a CommonJS build so the bump is transparent to minimatch. Remove once @vue/test-utils updates its own tree.",
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
