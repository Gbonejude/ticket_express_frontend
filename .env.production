# Values applied by `npm run build` (mode=production).
# Committed on purpose: it contains public configuration only, no secrets.
# Override per deployment with .env.production.local or real environment variables.

VITE_API_BASE_URL=https://api.ticketexpress.tg/api/v1
VITE_API_TIMEOUT=20000

VITE_APP_NAME=Ticket Express
VITE_APP_URL=https://ticketexpress.tg
VITE_APP_CURRENCY=XOF
VITE_APP_LOCALE=fr-FR
